# Copy to deploy/.env on the server and fill every value. Never commit the real file.

# Public domain (DNS A/AAAA must point to this server) and the email for Let's Encrypt notices.
APP_DOMAIN=app.example.com
ACME_EMAIL=admin@example.com

# PostgreSQL. The owner account runs migrations; the app account only reads and writes data.
POSTGRES_DB=aspireboot
POSTGRES_USER=aspireboot_owner
POSTGRES_PASSWORD=change-me-long-random

# RabbitMQ
RABBITMQ_USER=aspireboot
RABBITMQ_PASSWORD=change-me-long-random

# Redis (requirepass for the default user)
REDIS_PASSWORD=change-me-long-random

# RustFS (S3-compatible storage). Never use the default "rustfsadmin".
STORAGE_ACCESS_KEY=change-me
STORAGE_SECRET_KEY=change-me-long-random
STORAGE_BUCKET=aspireboot

# Outgoing email (your SMTP provider). TLS is required in production.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=change-me
EMAIL_PASSWORD=change-me
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=AspireBoot

# Optional OpenTelemetry collector (OTLP). Leave empty to disable export.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Passkeys (WebAuthn) and links are derived from APP_DOMAIN in compose.yaml:
#   Passkeys__ServerDomain = APP_DOMAIN, Passkeys__AllowedOrigins__0 = https://APP_DOMAIN, App__PublicBaseUrl = https://APP_DOMAIN.
# Passkeys only work on the public HTTPS origin, so no other value is needed.

# Optional identity and rate-limit tuning (defaults in code are used when unset; add them to compose.yaml to override):
#   Identity__EmailCooldownSeconds=60            minimum seconds between identity emails to one account
#   Identity__SecurityStampValidationSeconds=60  how often sessions are checked; a recovery or passkey removal ends other sessions within this interval
#   RateLimiting__<policy>__PermitLimit / __WindowSeconds  policies: signup, email-link, passkey-ceremony, authenticated, avatar-upload, public
#   Avatars__MaxConcurrentProcessing=2          avatar decodes running at the same time (process-wide, about 96 MB peak each); more waiting requests get 503 avatar.busy
#   Avatars__ProcessingWaitSeconds=10           how long an upload waits for a processing slot before 503 avatar.busy
#   Avatars__OrphanCheckDelay=01:00:00          delay before the Worker checks an uploaded avatar object that is no longer referenced; keep it above the longest upload
